# =====================================================================
# MikroTik SD-WAN Control Plane – Beispielkonfiguration
# Kopieren nach .env und ALLE "change-me"-Werte ersetzen! In Produktion startet die Plattform sonst nicht
# (Prüfung: deploy/check-secrets.sh .env).
# =====================================================================

# Öffentliche URL der Plattform (Router rufen hierüber das Onboarding-Script ab).
# In Produktion HTTPS über einen Reverse-Proxy (Caddy/Traefik/NPM) davor.
PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
ENVIRONMENT=production
# Reverse-Proxys, deren X-Forwarded-For gilt (IPs/CIDR, kommagetrennt). Default: Frontend-nginx (<SDWAN_NET>.30).
# Caddy/nginx auf dem Host: zusätzlich das Docker-Gateway <SDWAN_NET>.1; eigener Proxy (NPM/Traefik): dessen Adresse.
# TRUSTED_PROXIES=172.30.0.30,172.30.0.1

# --- Secrets (mit `openssl rand -hex 32` erzeugen) ---
SECRET_KEY=change-me-openssl-rand-hex-32
# Optional eigener Fernet-Key (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=
HUB_TOKEN=change-me-hub-token

# Erster MSP-Admin (wird nur angelegt, wenn noch kein Benutzer existiert)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-pw

# --- PostgreSQL ---
POSTGRES_USER=sdwan
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=sdwan

# --- InfluxDB 2 ---
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-influx
INFLUX_TOKEN=change-me-influx-token
INFLUX_ORG=sdwan
INFLUX_BUCKET=metrics

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PUBLIC_URL=http://localhost:8080/grafana

# --- WireGuard-Hub ---
# Öffentlicher Hostname/IP, unter dem Router den Hub per UDP erreichen
WG_HUB_ENDPOINT=vpn.example.com
WG_HUB_PORT=51820
WG_NETWORK=10.100.0.0/16
MESH_NETWORK=10.200.0.0/16

# --- RouterOS ---
# "api" = echte Router über den Tunnel, "simulator" = Demo ohne Hardware
ROUTEROS_BACKEND=simulator
# Nur Simulator: Gruppen mit mehr Rechten als der API-Benutzer ablehnen (Annahme über RouterOS, im Labor zu prüfen)
SIMULATOR_ENFORCE_GROUP_RIGHTS=true
POLL_INTERVAL_SECONDS=60

# --- SMTP für Alerts & Reports ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sdwan@example.com
SMTP_STARTTLS=true

# --- Branding (UI, Mails, PDF-Berichte) ---
PRODUCT_NAME=MikroTik-Fleet-Management
PRODUCT_SHORT=MFM
MAIL_ACCENT_COLOR=#0f766e
# optional: Logo (https) und Fußzeile mit MSP-Name + Support-Kontakt
MAIL_LOGO_URL=
MAIL_FOOTER_TEXT=
# 🔴/🟠/🔵/✅ im Betreff (false = ohne Emoji)
MAIL_SUBJECT_EMOJI=true

# --- NextDNS (Content-Filter) ---
NEXTDNS_API_KEY=

# --- Remote Access (SSH/Winbox-Proxy) ---
REMOTE_PROXY_HOST=localhost
REMOTE_PROXY_PORT_RANGE=40000-40019

# --- Host-Integration (bei Servern mit anderen Diensten) ---
# Frontend-Port/-Bind (hinter Reverse-Proxy: 127.0.0.1)
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=8080
API_PORT=8000
# Erste drei Oktette des internen Docker-Netzes (/24), falls 172.30.0.0/24 schon belegt ist
SDWAN_NET=172.30.0

# --- Speedtest (Phase 18): btest-Server, z. B. ein CHR mit /tool bandwidth-server; leer = deaktiviert ---
SPEEDTEST_SERVER=
SPEEDTEST_USER=
SPEEDTEST_PASSWORD=
SPEEDTEST_DURATION_S=10

# --- Syslog-Empfänger (Phase 18, UDP auf der Hub-Tunnel-IP) ---
SYSLOG_PORT=514

# --- IPFIX-Collector für Top-Verbraucher (Phase 25, UDP auf der Hub-Tunnel-IP, opt-in je Gerät) ---
FLOW_PORT=2055

# --- Plattform-Sicherung (Phase 21) – siehe docs/DISASTER-RECOVERY.md ---
# age-Public-Key (age1…). Der zugehörige Private Key gehört NICHT auf diesen Server. Leer = keine Sicherung.
PLATFORM_BACKUP_AGE_RECIPIENT=
PLATFORM_BACKUP_HOUR_UTC=3
PLATFORM_BACKUP_KEEP_DAYS=14
PLATFORM_BACKUP_HOST_DIR=./backups
# optional: rclone-Ziel (S3-kompatibel oder SFTP), Konfiguration in deploy/rclone/rclone.conf
PLATFORM_BACKUP_RCLONE_REMOTE=
PLATFORM_BACKUP_INFLUX=false
# Plattform-Benachrichtigungen (Sicherung fehlgeschlagen, 2FA-Reset …); leer = aus
PLATFORM_WEBHOOK_URL=


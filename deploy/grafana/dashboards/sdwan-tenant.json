{
  "uid": "sdwan-tenant",
  "title": "SD-WAN · Mandant",
  "tags": [
    "sdwan"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Mandant (ID)",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "sdwan-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"tenant_id\")",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Geräte mit Daten",
      "datasource": {
        "type": "influxdb",
        "uid": "sdwan-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "sdwan-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r._field == \"cpu_load\")\n  |> filter(fn: (r) => contains(value: r.tenant_id, set: ${tenant:json}))\n  |> group(columns: [])\n  |> last() |> group() |> count()"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "WAN-Links down",
      "datasource": {
        "type": "influxdb",
        "uid": "sdwan-influx"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": null
            },
            {
              "color": "red",
              "value": 1
            }

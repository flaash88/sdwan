          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wan\" and r._field == \"up\")\n  |> filter(fn: (r) => contains(value: r.tenant_id, set: ${tenant:json}))\n  |> group(columns: [\"device\", \"wan\"])\n  |> last() |> filter(fn: (r) => r._value == 0) |> group() |> count()"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
